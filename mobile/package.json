{
  "name": "1234webtool-hybrid-app",
  "version": "1.0.0",
  "description": "Hybrid mobile app for 1234WebTool using Capacitor (Android & iOS)",
  "private": true,
  "scripts": {
    "sync-web": "bash scripts/sync-assets.sh",
    "cap": "cap",
    "sync": "cap sync",
    "copy": "cap copy",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "build:release-apk": "cd android && ./gradlew assembleRelease",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/ios": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1"
  }
}
